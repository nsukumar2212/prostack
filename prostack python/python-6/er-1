#extracting data from the API

import requests
user_response = requests.get("https://jsonplaceholder.typicode.com/users")
users = user_response.json()

print(len(users))

#transforming the data into JSON and CSV formats

users_json=[]
users_csv=[]

for user in users:
    users_json.append({"userid": user['id'],
                       "username": user['username'],
                       "location": user['address']['city'],
                       "company": user['company']['name']
                       })


users_csv.append((user['id'],
                      user['username'],
                      user['address']['city'],
                      user['company']['name']
                      )) 


#loading the data into a JSON file

import json,csv
fp1=open('users.json','w')
json.dump(users_json,fp1)
print("New JSON file created successfully")

fp2=open('users.csv','w')
csv_writer=csv.writer(fp2)
csv_writer.writerow(['userid','username','location','company'])
csv_writer.writerows(users_csv)
print("New CSV file created successfully")      